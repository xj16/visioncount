# VisionCount dashboard configuration. Copy to .env and adjust as needed.
# Every value below is optional; the defaults run the synthetic feed with no auth.

# Video source: "synthetic", a webcam index like "0", or a video file path.
VISIONCOUNT_SOURCE=synthetic

# Start the OpenCV worker thread eagerly when the app is created (1) or lazily on
# the first HTTP request (0). Docker/production should use 1.
VISIONCOUNT_AUTOSTART=1

# Bind address / port.
HOST=127.0.0.1
PORT=5000

# --- Persistence ----------------------------------------------------------
# Log every crossing to this SQLite file (enables durable /export.csv + /api/events
# across restarts). Leave unset for in-memory-only.
# VISIONCOUNT_DB=/data/visioncount.sqlite

# POST each crossing (JSON) to this URL, best-effort, off the video loop.
# VISIONCOUNT_WEBHOOK=https://example.com/hooks/visioncount

# Size of the in-memory recent-events ring buffer.
VISIONCOUNT_EVENT_BUFFER=500

# --- Security -------------------------------------------------------------
# Require this key (X-API-Key header or ?api_key=) on mutating endpoints
# (/api/lines POST/DELETE, /api/zones POST). Unset = mutations are open.
# VISIONCOUNT_API_KEY=change-me

# Requests/minute per client on mutating + export endpoints.
VISIONCOUNT_RATE_LIMIT=120

# Allowed CORS origin. Unset (default) = no CORS headers emitted (most secure).
# VISIONCOUNT_CORS_ORIGIN=https://example.com
